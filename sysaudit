#!/usr/bin/env bash
# =============================================================================
# sysaudit — read-only Linux system health audit
# Copyright (c) 2026 SYSNETSOL — MIT License
#
# Prints a plain-text health report to stdout: OS/kernel, CPU load, memory,
# disk usage (with a warn threshold), pending package updates (dry-run only),
# listening TCP ports, recent failed SSH logins, and key service states.
#
# Read-only: this script NEVER installs updates or changes any system state.
# apt-get is only ever run with '-s' (simulate). Missing tools, missing
# permissions and non-systemd systems are tolerated with clear notes.
# =============================================================================
set -u

VERSION="1.0.0"
WARN_DISK=80   # warn when a filesystem is >= this % full

case "${1:-}" in
    -h|--help)
        cat <<'EOF'
sysaudit 1.0.0 — read-only Linux system health audit

Usage: sysaudit [--help] [--version]

Prints a plain-text report covering:
  * OS, kernel, hostname, uptime
  * CPU count and load averages
  * Memory and swap usage
  * Disk usage (warning at >= 80%)
  * Pending package updates (apt-get -s / dnf check-update; dry-run only)
  * Listening TCP ports
  * Recent failed SSH login attempts
  * State of common services (sshd, cron, networking, ...)

The script is read-only: it never installs anything or changes system state.
Some sections may be limited when run as a non-root user.

Exit status: 0 if the report completed, 1 if a fatal error occurred.
EOF
        exit 0 ;;
    -V|--version)
        echo "sysaudit ${VERSION}"
        exit 0 ;;
    "")
        : ;;
    *)
        echo "sysaudit: unknown option '$1' (try --help)" >&2
        exit 2 ;;
esac

have() { command -v "$1" >/dev/null 2>&1; }

hdr()  { printf '\n=== %s ===\n' "$1"; }
line() { printf '%-22s %s\n' "$1" "$2"; }

echo "sysaudit ${VERSION} — system health report"
echo "generated: $(date -u +%Y-%m-%dT%H:%M:%SZ)"

# ------------------------------------------------------------- system
hdr "System"
line "hostname:" "$(hostname 2>/dev/null || echo unknown)"
if [ -r /etc/os-release ]; then
    # shellcheck disable=SC1091
    line "os:" "$(grep '^PRETTY_NAME=' /etc/os-release | cut -d= -f2 | tr -d '"')"
else
    line "os:" "unknown (no /etc/os-release)"
fi
line "kernel:" "$(uname -r 2>/dev/null || echo unknown)"
if have uptime; then
    line "uptime:" "$(uptime -p 2>/dev/null || uptime | sed 's/^ *//')"
else
    line "uptime:" "unavailable (uptime not installed)"
fi

# --------------------------------------------------------------- cpu
hdr "CPU"
line "logical CPUs:" "$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || echo unknown)"
if [ -r /proc/loadavg ]; then
    line "load average:" "$(cut -d' ' -f1-3 /proc/loadavg)"
else
    line "load average:" "unavailable"
fi
if have lscpu; then
    line "model:" "$(lscpu 2>/dev/null | grep '^Model name' | sed 's/Model name:[[:space:]]*//' | head -1 || echo unknown)"
fi

# ------------------------------------------------------------ memory
hdr "Memory"
if have free; then
    MEM=$(free -m 2>/dev/null | awk '/^Mem:/ {printf "%s MB total, %s MB used, %s MB available (%d%% used)", $2, $3, $7, ($2-$7)*100/$2}')
    line "memory:" "${MEM:-unavailable}"
    SWAP=$(free -m 2>/dev/null | awk '/^Swap:/ {printf "%s MB total, %s MB used", $2, $3}')
    line "swap:" "${SWAP:-unavailable}"
elif [ -r /proc/meminfo ]; then
    TOTAL=$(awk '/^MemTotal:/ {printf "%d", $2/1024}' /proc/meminfo)
    AVAIL=$(awk '/^MemAvailable:/ {printf "%d", $2/1024}' /proc/meminfo)
    line "memory:" "${TOTAL} MB total, ${AVAIL} MB available (from /proc/meminfo)"
else
    line "memory:" "unavailable (no free or /proc/meminfo)"
fi

# --------------------------------------------------------------- disk
hdr "Disk usage (warning at >= ${WARN_DISK}%)"
if have df; then
    df -h --output=source,size,used,avail,pcent,target -x tmpfs -x devtmpfs 2>/dev/null \
        | tail -n +2 | while read -r src size used avail pct mnt; do
        num=${pct%%%}
        if [ "$num" -ge "$WARN_DISK" ] 2>/dev/null; then
            line "${src} on ${mnt}:" "WARNING: ${pct} full (${used} used of ${size})"
        else
            line "${src} on ${mnt}:" "${pct} full (${used} used of ${size})"
        fi
    done
    if [ -f /run/reboot-required ]; then
        line "note:" "system reboot is pending (/run/reboot-required exists)"
    fi
else
    line "disk:" "unavailable (df not installed)"
fi

# ----------------------------------------------------- pending updates
hdr "Pending updates (dry-run only — nothing is installed)"
if have apt-get; then
    # Simulate only; never touches the system beyond an apt metadata read.
    SIM=$(apt-get -s upgrade 2>/dev/null)
    if [ -z "$SIM" ]; then
        line "apt:" "could not simulate upgrade (run again as root or check apt config)"
    else
        COUNT=$(printf '%s' "$SIM" | grep -c '^Inst ')
        PKGS=$(printf '%s' "$SIM" | awk '/^Inst / {print $2}' | head -10 | tr '\n' ' ')
        line "upgradable:" "${COUNT} package(s)"
        [ -n "$PKGS" ] && line "sample:" "$PKGS"
    fi
elif have dnf; then
    if OUT=$(dnf check-update -q 2>/dev/null); then
        line "upgradable:" "0 (system up to date)"
    else
        COUNT=$(printf '%s' "$OUT" | grep -cvE '^( *$|Last metadata)')
        line "upgradable:" "${COUNT} package(s) (dnf check-update)"
    fi
else
    line "updates:" "no supported package manager found (apt/dnf); check manually"
fi

# ---------------------------------------------------- listening ports
hdr "Listening TCP ports"
if have ss; then
    OUT=$(ss -tlnp 2>/dev/null | tail -n +2)
    if [ -n "$OUT" ]; then
        printf '%s\n' "$OUT" | head -30
    else
        echo "no listening TCP ports found (or permission denied)"
    fi
elif have netstat; then
    OUT=$(netstat -tlnp 2>/dev/null | tail -n +2)
    if [ -n "$OUT" ]; then
        printf '%s\n' "$OUT" | head -30
    else
        echo "no listening TCP ports found (or permission denied)"
    fi
else
    echo "unavailable (neither ss nor netstat installed)"
fi

# ------------------------------------------------------- failed SSH
hdr "Failed SSH logins (recent, read-only log scan)"
FOUND=0
if have journalctl; then
    if OUT=$(journalctl --no-pager -u ssh -u sshd -p err --since "24 hours ago" 2>&1); then
        HITS=$(printf '%s' "$OUT" | grep -ciE 'failed|invalid user|authentication failure' || true)
        line "journalctl (ssh/sshd):" "${HITS} matching event(s) in last 24h"
        printf '%s' "$OUT" | grep -iE 'failed|invalid user|authentication failure' | tail -5 | sed 's/^/  /'
        FOUND=1
    else
        line "journalctl:" "not accessible ($(printf '%s' "$OUT" | head -1 | cut -c1-90))"
    fi
fi
if [ "$FOUND" -eq 0 ] && [ -r /var/log/auth.log ]; then
    HITS=$(grep -cE 'Failed password|Invalid user' /var/log/auth.log 2>/dev/null || true)
    line "/var/log/auth.log:" "${HITS} matching event(s) in current log"
    grep -hE 'Failed password|Invalid user' /var/log/auth.log 2>/dev/null | tail -5 | sed 's/^/  /'
    FOUND=1
fi
if [ "$FOUND" -eq 0 ]; then
    echo "unavailable (journalctl not permitted and /var/log/auth.log not readable)"
fi

# --------------------------------------------------------- services
hdr "Key service states (systemctl, tolerated when unavailable)"
if have systemctl && systemctl is-system-running >/dev/null 2>&1; then
    for svc in sshd ssh cron systemd-resolved NetworkManager networking docker; do
        STATE=$(systemctl is-active "$svc" 2>/dev/null)
        line "${svc}:" "${STATE:-unknown}"
    done
else
    echo "systemctl not available or no systemd running; service state unknown"
fi

echo
echo "--- end of report ---"
exit 0
